# Copy to app/.env and fill in as needed. EXPO_PUBLIC_* values are bundled into the app.

# Optional. With a key, catalog search uses Google Books (better coverage of
# Spanish editions). Without it, Leora uses Open Library, which needs no key.
# Create one at https://console.cloud.google.com/apis/credentials (Books API).
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Optional affiliate tracking for the "Get it" buttons (see src/lib/stores.ts).
# Amazon Associates tag (afiliados.amazon.es), e.g. leora-21
EXPO_PUBLIC_AMAZON_TAG=
# Deep-link templates from your affiliate network; {url} is replaced by the encoded store URL.
# Example (Awin): https://www.awin1.com/cread.php?awinmid=MERCHANT_ID&awinaffid=YOUR_ID&ued={url}
EXPO_PUBLIC_AFFILIATE_CASADELLIBRO=
EXPO_PUBLIC_AFFILIATE_FNAC=
EXPO_PUBLIC_AFFILIATE_KOBO=
EXPO_PUBLIC_AFFILIATE_AUDIBLE=
